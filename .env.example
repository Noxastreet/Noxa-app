# Copy this file to .env.local and add the public client configuration.
# Expo embeds every EXPO_PUBLIC_ value in the application bundle.
# Never put Supabase service-role/secret keys or other private credentials here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
